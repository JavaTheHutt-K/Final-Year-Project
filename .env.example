# Cloud Run supplies PORT. This value is for local container testing.
PORT=8080

# Set to the exact origin of the Vercel deployment (no trailing slash).
FRONTEND_URL=https://your-project.vercel.app

# Mount the dataset directory into the container; do not bake the CSV into the image.
IDS_DATA_DIR=/mnt/datasets
IDS_RESULTS_DIR=/tmp/ids-results
RAY_TMPDIR=/tmp/ray
LOG_LEVEL=INFO

# Backend-only Gemini credentials and supported model from Google's Gen AI API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase service-role credentials: keep these only in backend/worker secrets.
SUPABASE_URL=
SUPABASE_KEY=

# Administrator credentials: ADMIN_PASSWORD_HASH is pbkdf2_sha256$rounds$salt$digest
# and ADMIN_TOKEN_SECRET must contain at least 32 random bytes.
GRADIO_ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_SECRET=

# Cloud Run service and worker job settings.
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=
CLOUD_RUN_JOB=
IDS_GCS_BUCKET=
