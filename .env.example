# Cloud Run supplies PORT. This value is for local container testing.
PORT=8080

# Set to the exact origin of the Vercel deployment (no trailing slash).
FRONTEND_URL=https://your-project.vercel.app

# Mount the dataset directory into the container; do not bake the CSV into the image.
IDS_DATA_DIR=/mnt/datasets
IDS_RESULTS_DIR=/tmp/ids-results
RAY_TMPDIR=/tmp/ray
LOG_LEVEL=INFO

# Optional post-run AI comparison (OpenAI-compatible chat completions API).
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions

# Reserved for a future Supabase integration. No database connection is made yet.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
